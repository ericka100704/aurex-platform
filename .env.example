# PostgreSQL (Supabase — use Connect → ORM → Prisma)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AUREX"

# Auth (generate a long random string)
JWT_SECRET="change-me-to-a-long-random-secret"

# Cron (Vercel sends Authorization: Bearer CRON_SECRET to /api/cron/roi)
# Daily ROI: 00:05 Asia/Manila (16:05 UTC)
CRON_SECRET="change-me-to-a-long-random-cron-secret"

# PayMongo (GCash / Maya / QR Ph). Leave empty to keep manual receipt deposits.
# Dashboard → Developers → API keys. Webhook URL: https://YOUR_DOMAIN/api/webhooks/paymongo
# Subscribe to: checkout_session.payment.paid
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Supabase Storage (receipts). Project Settings → API.
# service_role is server-only — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Email (forgot password + verify). https://resend.com API keys
RESEND_API_KEY=""
MAIL_FROM="AUREX <noreply@yourdomain.com>"
